{
    // Rust 调试配置 —— 需要安装 CodeLLDB 扩展 (vadimcn.vscode-lldb)
    // 文档: https://github.com/vadimcn/codelldb
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug CLI (patternstudio)",
            "cargo": {
                // 构建要调试的二进制（debug 模式，带调试符号）
                "args": ["build", "--bin=patternstudio", "--package=patternstudio-cli"],
                "filter": {
                    "name": "patternstudio",
                    "kind": "bin"
                }
            },
            // 传给程序启动参数的示例:
            // "args": ["trace", "path/to/image.png", "-o", "out.svg"],
            // "args": ["pattern", "-k", "grid", "-n", "5", "-o", "out.svg"],
            "args": [],
            // 程序的工作目录
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Server (patternstudio-server)",
            "cargo": {
                "args": ["build", "--bin=patternstudio-server", "--package=patternstudio-server"],
                "filter": {
                    "name": "patternstudio-server",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Desktop (Tauri)",
            // 跑 .app bundle 里的二进制 → Dock 显示校徽图标（裸二进制只能显示默认图标）。
            // preLaunchTask 会: 规范化 icon.png 为 8-bit RGBA + cargo build + 把新二进制
            // copy 进 .app（否则 .app 里是旧二进制）。断点打在 desktop/src/lib.rs。
            // 注意: 必须带 tauri/custom-protocol，否则是 dev 模式（需 vite dev server）→ 白屏
            "preLaunchTask": "build desktop (.app ready)",
            "program": "${workspaceFolder}/target/debug/PatternStudio.app/Contents/MacOS/patternstudio-desktop",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Tests (workspace)",
            "cargo": {
                // 编译测试但不运行，然后附加调试
                "args": ["test", "--no-run", "--workspace"],
                "filter": {
                    "name": "patternstudio.*",
                    "kind": "bin"
                }
            },
            // 只运行指定测试，例如:
            // "args": ["some_test_name", "--exact"],
            "args": []
        }
    ],
    "compounds": [
        {
            "name": "Debug CLI + attach",
            "configurations": ["Debug CLI (patternstudio)"]
        }
    ]
}
