{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build (workspace)",
            "type": "cargo",
            "command": "build",
            "args": ["--workspace"],
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo test (workspace)",
            "type": "cargo",
            "command": "test",
            "args": ["--workspace"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo clippy",
            "type": "cargo",
            "command": "clippy",
            "args": ["--workspace", "--", "-D", "warnings"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo fmt",
            "type": "cargo",
            "command": "fmt",
            "args": ["--all"],
            "problemMatcher": []
        }
    ]
}
