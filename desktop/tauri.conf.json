{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PatternStudio",
  "version": "0.1.0",
  "identifier": "com.futuremeng.patternstudio",
  "build": {
    "beforeDevCommand": "cd ../web && npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "cd ../web && npm run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PatternStudio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
